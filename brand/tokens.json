{
  "name": "Petboss 24",
  "version": "2026-10",
  "color": {
    "brand": {
      "orange": "#FF6600",
      "violet": "#9C2CF3",
      "grayDark": "#404040"
    },
    "neutral": {
      "white": "#FFFFFF",
      "grayLight": "#E5E5E5",
      "appBackground": "#161616",
      "appSurface": "#2C2C2C"
    },
    "dark": {
      "background": "#161616",
      "surface": "#2C2C2C",
      "text": "#FFFFFF",
      "textSecondary": "#B3B3B3"
    },
    "light": {
      "background": "#FFFFFF",
      "surface": "#E5E5E5",
      "text": "#404040",
      "textSecondary": "#6B6B6B"
    }
  },
  "font": {
    "display": {
      "family": "Raleway",
      "stack": "\"Raleway\", system-ui, sans-serif",
      "weights": [
        700,
        800
      ]
    },
    "text": {
      "family": "Poppins",
      "stack": "\"Poppins\", system-ui, sans-serif",
      "weights": [
        400,
        500,
        600,
        700
      ]
    }
  },
  "typeScale": {
    "display": {
      "font": "Raleway",
      "weight": 800,
      "size": 96,
      "lineHeight": 91
    },
    "heading": {
      "font": "Raleway",
      "weight": 800,
      "size": 28,
      "lineHeight": 32
    },
    "subheading": {
      "font": "Raleway",
      "weight": 700,
      "size": 20,
      "lineHeight": 26
    },
    "button": {
      "font": "Poppins",
      "weight": 700,
      "size": 18,
      "lineHeight": 24
    },
    "body": {
      "font": "Poppins",
      "weight": 400,
      "size": 16,
      "lineHeight": 23
    },
    "bodySmall": {
      "font": "Poppins",
      "weight": 400,
      "size": 15,
      "lineHeight": 21
    },
    "label": {
      "font": "Poppins",
      "weight": 600,
      "size": 13,
      "lineHeight": 18,
      "letterSpacing": "0.02em"
    }
  },
  "radius": {
    "nested": 8,
    "default": 14,
    "pill": 999
  },
  "spacing": [
    4,
    8,
    16,
    24
  ],
  "button": {
    "radius": 14,
    "paddingY": 14,
    "paddingX": 24,
    "primary": {
      "background": "#FF6600",
      "text": "#FFFFFF",
      "pressed": "#A84400"
    },
    "secondary": {
      "dark": {
        "background": "#2C2C2C",
        "text": "#FFFFFF",
        "pressed": "#272727"
      },
      "light": {
        "background": "#E5E5E5",
        "text": "#404040",
        "pressed": "#CACACA"
      }
    }
  },
  "shadow": "none",
  "maxWidth": 430,
  "chip": {
    "radius": 999,
    "paddingY": 8,
    "paddingX": 16,
    "selectedOutline": {
      "color": "#FF6600",
      "width": 1.5
    }
  }
}
